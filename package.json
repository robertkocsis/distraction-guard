{
  "name": "distraction-guard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/chrome": "^0.1.43",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "sass": "^1.107.0",
    "sharp": "^0.34.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.12"
  }
}

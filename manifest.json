{
  "manifest_version": 3,
  "name": "Distraction Guard",
  "version": "1.0.0",
  "description": "Add intentional friction to distracting websites.",
  "permissions": [
    "storage",
    "webNavigation",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/worker.ts",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/block/block.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
